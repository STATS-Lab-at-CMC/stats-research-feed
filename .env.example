# Optional accounts (Supabase). Leave these unset and the app runs exactly as
# it always has: everything is saved in the browser, and no sign-in UI appears.
#
# Set them to turn on optional accounts, which sync a user's journal watchlist,
# seen articles, and saved articles across devices. See SUPABASE_SETUP.md.
#
# Both values are public by design — they are compiled into the browser bundle.
# The anon key is a *publishable* key whose privileges are defined entirely by
# the row-level security policies in supabase/migrations/. Never put the
# service_role key here, or anywhere else in this repository.

# Use the bare Project URL, NOT the REST endpoint shown beside it in the
# dashboard. Copying ".../rest/v1/" by mistake is the most common setup error;
# the app strips that suffix defensively, but get it right here anyway.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key


# ---------------------------------------------------------------------------
# OpenAlex API key (optional, but strongly recommended)
# ---------------------------------------------------------------------------
# As of October 2026 OpenAlex requires a key to page past the FIRST page of
# results with cursor=. Without one, a 26-journal watchlist truncates to 100
# articles and the app shows a "showing only part of your feed" banner.
#
# Note there is NO NEXT_PUBLIC_ prefix: this is read only on the server, by
# the /api/openalex proxy route, and never reaches the browser. Do not add the
# prefix — this site is public, and the key carries your daily budget.
#
# Get one free in about a minute at https://openalex.org/settings/api

OPENALEX_API_KEY=
